#!/bin/bash
# First-boot setup for the LiveKit instance (Amazon Linux 2023). Rendered by Terraform.
# Secrets are not part of user data: fetch-keys.sh reads them from SSM at every start.
# Never enable `set -x` here: cloud-init output is written to /var/log.
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

install -d -m 0755 /opt/livekit
install -d -m 0700 /opt/livekit/caddy_data

cat > /opt/livekit/livekit.yaml <<'LIVEKIT_YAML'
${livekit_yaml}
LIVEKIT_YAML

cat > /opt/livekit/caddy.yaml <<'CADDY_YAML'
${caddy_yaml}
CADDY_YAML

cat > /opt/livekit/fetch-keys.sh <<'FETCH_KEYS'
#!/bin/bash
# Writes the LiveKit key file from SSM. LiveKit refuses a key file readable by others.
set -euo pipefail
umask 077
get() {
  aws ssm get-parameter --region "${aws_region}" --with-decryption \
    --name "$1" --query Parameter.Value --output text
}
key="$(get "${api_key_parameter}")"
secret="$(get "${api_secret_parameter}")"
tmp="$(mktemp /opt/livekit/keys.yaml.XXXXXX)"
printf "%s: '%s'\n" "$key" "$secret" > "$tmp"
mv -f "$tmp" /opt/livekit/keys.yaml
FETCH_KEYS
chmod 0700 /opt/livekit/fetch-keys.sh

cat > /etc/systemd/system/livekit.service <<'LIVEKIT_UNIT'
[Unit]
Description=LiveKit server (Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
LimitNOFILE=500000
Restart=always
RestartSec=5
TimeoutStartSec=300
ExecStartPre=/opt/livekit/fetch-keys.sh
ExecStartPre=-/usr/bin/docker rm -f livekit
ExecStartPre=/usr/bin/docker pull ${livekit_image}
ExecStart=/usr/bin/docker run --rm --name livekit --network host \
  -v /opt/livekit/livekit.yaml:/etc/livekit.yaml:ro \
  -v /opt/livekit/keys.yaml:/etc/livekit-keys.yaml:ro \
  ${livekit_image} --config /etc/livekit.yaml
ExecStop=/usr/bin/docker stop livekit

[Install]
WantedBy=multi-user.target
LIVEKIT_UNIT

cat > /etc/systemd/system/caddy.service <<'CADDY_UNIT'
[Unit]
Description=Caddy layer4 TLS proxy for LiveKit (Docker)
After=docker.service network-online.target livekit.service
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
ExecStartPre=-/usr/bin/docker rm -f caddy
ExecStartPre=/usr/bin/docker pull ${caddy_image}
ExecStart=/usr/bin/docker run --rm --name caddy --network host \
  -v /opt/livekit/caddy.yaml:/etc/caddy.yaml:ro \
  -v /opt/livekit/caddy_data:/data \
  ${caddy_image} run --config /etc/caddy.yaml --adapter yaml
ExecStop=/usr/bin/docker stop caddy

[Install]
WantedBy=multi-user.target
CADDY_UNIT

systemctl daemon-reload
systemctl enable --now livekit.service caddy.service
