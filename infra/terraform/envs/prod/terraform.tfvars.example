project_name          = "watchparty"
env                   = "prod"
aws_region            = "ap-southeast-1"
app_domain            = "watchparty.chescloud.my.id"
room_max_participants = 10
tags                  = {}

# --- RTC (LiveKit EC2) ---
# route53_zone_id: isi setelah delegasi DNS aktif; biarkan null jika belum.
# route53_zone_id    = "Z0123456789ABCDEFGHIJ"
rtc_instance_type    = "t3.small"
# rtc_schedule_enabled wajib true jika rtc_instance_type = "c7i-flex.large".
rtc_schedule_enabled = false
