# LiveKit server config (rendered by Terraform; contains no secrets).
# Based on the output of livekit/generate (VM deployment, server only, no Redis).
# Reference: https://github.com/livekit/livekit/blob/v1.13.11/config-sample.yaml
port: 7880

logging:
  level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  # The Elastic IP is known at plan time, so no STUN lookup is needed at startup.
  use_external_ip: false
  node_ip: ${public_ip}

turn:
  enabled: true
  domain: ${turn_domain}
  # Caddy terminates TLS on 443 (SNI turn.) and forwards plain TCP here.
  tls_port: 5349
  external_tls: true
  udp_port: 3478

room:
  auto_create: true
  max_participants: ${max_participants}
  empty_timeout: 300

# API key/secret are written from SSM at every service start (fetch-keys.sh).
key_file: /etc/livekit-keys.yaml
