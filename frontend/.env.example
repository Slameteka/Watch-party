# Base URL REST API Backend Watch Party
# Default untuk development lokal dengan mock-server: http://localhost:8787
# Untuk staging/produksi: isi dengan domain API yang sesuai
VITE_API_URL=http://localhost:8787

# Kirim kredensial/cookies pada request segmen video HLS
# Set 'false' untuk mock server lokal
# Set 'true' saat mengakses CloudFront produksi dengan signed cookies
VITE_HLS_WITH_CREDENTIALS=false

# Konfigurasi AWS Cognito Host Login (Hanya diperlukan saat integrasi cloud)
# Biarkan kosong saat pengembangan lokal dengan mock-server
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
